# Copie para .env e preencha. O .env nunca vai pro git.

# Chave da API do Claude (https://platform.claude.com), cobrada por uso
ANTHROPIC_API_KEY=

# Pasta onde o Alfred procura seus repositórios (padrão: C:/dev)
# ALFRED_CWD=C:/dev

# Pasta com as planilhas/extratos do Nexus (padrão: ./data/financas)
# NEXUS_CWD=./data/financas
